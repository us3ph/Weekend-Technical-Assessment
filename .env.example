# Optional server-only settings for the OpenRouter provider path.
# The application remains runnable without these values and falls back to
# a clearly labelled deterministic summary when the key is absent.
# Copy to .env.local when needed; never commit or expose a real key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Step 03 will use the supplied root workbook by default.
# To evaluate changed input later, set an absolute path to a separate XLSX copy.
# Leave the original workbook unchanged. Example (placeholder only):
# WORKBOOK_PATH="/absolute/path/to/edited-workbook.xlsx"
